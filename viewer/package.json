{
  "name": "@molscene/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript adapter: reads a molscene JSON scene spec and drives a WebGL renderer (3Dmol.js in v0.1).",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" build.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" build.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "esbuild": "^0.24.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "three": "^0.171.0"
  }
}
